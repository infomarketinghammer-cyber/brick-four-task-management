// ==============================================================================
// PRISMA SCHEMA: HIERARCHICAL TASK MANAGEMENT SYSTEM
// Provider: PostgreSQL
// ==============================================================================
//
// SYSTEM ARCHITECTURE & BUSINESS RULES:
//
// 1. ORGANIZATIONAL HIERARCHY (4-LEVEL DOWNWARD FLOW)
//    - Hierarchy Levels:
//      Level 0: ADMIN (Founder/C-Level)
//      Level 1: DEPT_HEAD (Department Heads)
//      Level 2: TEAM_LEAD (Team Leads)
//      Level 3: EXECUTIVE (Individual Contributors / Staff)
//    - Manager Constraint: Every user except ADMIN (level 0) has exactly one manager_id.
//
// 2. TASK DELEGATION MODEL & DELEGATION CHAINS
//    - Delegation Mechanics:
//      When User A (e.g. Dept Head) assigns Task T1 to User B (e.g. Team Lead), and
//      User B delegates work to User C (e.g. Executive):
//        a. A NEW Task row T2 is created.
//        b. T2.parent_task_id = T1.id
//        c. T2.root_task_id   = T1.root_task_id ?? T1.id  (Points to top ancestor T1)
//        d. T2.depth          = T1.depth + 1
//        e. T2.created_by_id  = User B (Delegator)
//        f. T2.assigned_to_id = User C (Delegatee)
//    - Denormalized `root_task_id` enables O(1) query rollups for entire delegation trees
//      without recursive CTE queries.
//
// 3. PARENT TASK PROGRESS & WEIGHTED AGGREGATION
//    - Progress Formula:
//      A parent task's progress_percent is calculated as a weighted average of its
//      immediate child tasks' progress_percent.
//      
//      Weight_i = child_task_i.estimated_hours ?? 1.0
//      
//      Parent_Progress = SUM(child_task_i.progress_percent * Weight_i) / SUM(Weight_i)
//      
//      - If a child has sub-children, the calculation rolls up bottom-up recursively:
//        Leaf Tasks -> Sub-parents -> Parent -> Root Task.
//      - Completion status: Parent auto-transitions to UNDER_REVIEW or COMPLETED when all
//        child tasks reach 100% progress and pass approval.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum Role {
  ADMIN
  DEPT_HEAD
  TEAM_LEAD
  EXECUTIVE
}

enum TaskStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  SUBMITTED
  UNDER_REVIEW
  COMPLETED
  REOPENED
  CANCELLED
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DELEGATED
  STATUS_CHANGED
  COMMENT_ADDED
  MENTIONED
  DUE_SOON
  OVERDUE
  APPROVAL_REQUESTED
  APPROVED
  REJECTED
  REMINDER
  MESSAGE_RECEIVED
}

enum ConversationType {
  DIRECT
  GROUP
  TASK_THREAD
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

// ------------------------------------------------------------------------------
// MODELS
// ------------------------------------------------------------------------------

/// User model representing employees across the 4-level hierarchy.
model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  phone           String?
  password_hash   String
  avatar_url      String?
  role            Role
  manager_id      String?   // Nullable only for ADMIN (level 0)
  department      String
  designation     String
  hierarchy_level Int       // 0: ADMIN, 1: DEPT_HEAD, 2: TEAM_LEAD, 3: EXECUTIVE
  is_active       Boolean   @default(true)
  last_login_at   DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Self-relation for organizational hierarchy
  manager      User?  @relation("UserHierarchy", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinates User[] @relation("UserHierarchy")

  // Application Relations
  created_tasks             Task[]                    @relation("CreatedTasks")
  assigned_tasks            Task[]                    @relation("AssignedTasks")
  comments                  Comment[]                 @relation("CommentAuthor")
  attachments               Attachment[]              @relation("UploadedAttachments")
  reminders                 Reminder[]                @relation("UserReminders")
  notifications_received    Notification[]            @relation("RecipientNotifications")
  notifications_triggered   Notification[]            @relation("ActorNotifications")
  activity_logs             ActivityLog[]             @relation("ActorActivityLogs")
  sent_messages             Message[]                 @relation("MessageSender")
  conversation_participants ConversationParticipant[]
  requested_approvals       Approval[]                @relation("RequestedApprovals")
  approver_approvals        Approval[]                @relation("ApproverApprovals")
  watched_tasks             TaskWatcher[]             @relation("UserWatchedTasks")

  @@index([manager_id])
  @@index([role])
  @@index([department])
  @@index([hierarchy_level])
}

/// Task model representing actionable work units, supporting nesting and delegation chains.
model Task {
  id               String       @id @default(uuid())
  title            String
  description      String?      // Rich text markup / markdown
  created_by_id    String
  assigned_to_id   String
  parent_task_id   String?      // Foreign key for task delegation/parent-child hierarchy
  root_task_id     String?      // Denormalized pointer to top of delegation chain for fast rollup
  depth            Int          @default(0) // Delegation depth (0 = top-level)
  status           TaskStatus   @default(ASSIGNED)
  priority         TaskPriority @default(MEDIUM)
  start_date       DateTime?
  due_date         DateTime?
  completed_at     DateTime?
  estimated_hours  Decimal?     @db.Decimal(6, 2)
  actual_hours     Decimal?     @db.Decimal(6, 2)
  progress_percent Int          @default(0) // 0 to 100
  is_recurring     Boolean      @default(false)
  recurrence_id    String?
  is_deleted       Boolean      @default(false)
  deleted_at       DateTime?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  // Relations
  created_by      User            @relation("CreatedTasks", fields: [created_by_id], references: [id], onDelete: Restrict)
  assigned_to     User            @relation("AssignedTasks", fields: [assigned_to_id], references: [id], onDelete: Restrict)
  parent_task     Task?           @relation("TaskDelegation", fields: [parent_task_id], references: [id], onDelete: Cascade)
  child_tasks     Task[]          @relation("TaskDelegation")
  root_task       Task?           @relation("RootTaskChain", fields: [root_task_id], references: [id], onDelete: Cascade)
  sub_tasks       Task[]          @relation("RootTaskChain")
  recurrence_rule RecurrenceRule? @relation(fields: [recurrence_id], references: [id], onDelete: SetNull)

  // Sub-entity Relations
  comments             Comment[]
  attachments          Attachment[]
  reminders            Reminder[]
  activity_logs        ActivityLog[]
  approvals            Approval[]
  watchers             TaskWatcher[]
  tags                 TaskTag[]
  linked_conversations Conversation[]

  // Indexes for frequent querying
  @@index([assigned_to_id, status])
  @@index([due_date])
  @@index([root_task_id])
  @@index([parent_task_id])
  @@index([created_by_id])
  @@index([status])
  @@index([is_deleted])
}

/// Recurrence Rule definition for repeating tasks.
model RecurrenceRule {
  id              String              @id @default(uuid())
  frequency       RecurrenceFrequency
  interval        Int                 @default(1) // e.g. 2 = every 2 weeks
  days_of_week    Int[]               // For WEEKLY e.g. [1, 3, 5] (Mon, Wed, Fri)
  day_of_month    Int?                // For MONTHLY e.g. 15th
  custom_dates    DateTime[]          // Array of specific calendar dates
  starts_on       DateTime
  ends_on         DateTime?
  max_occurrences Int?
  next_run_at     DateTime?
  is_active       Boolean             @default(true)
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  tasks Task[]
}

/// Scheduled reminder notifications for individual tasks.
model Reminder {
  id                         String              @id @default(uuid())
  task_id                    String
  user_id                    String
  remind_at                  DateTime
  offset_minutes_before_due Int?
  channel                    NotificationChannel @default(IN_APP)
  is_sent                    Boolean             @default(false)
  sent_at                    DateTime?
  is_recurring_reminder      Boolean             @default(false)
  created_at                 DateTime            @default(now())
  updated_at                 DateTime            @updatedAt

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user User @relation("UserReminders", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@index([user_id])
  @@index([remind_at, is_sent])
}

/// Comment threads on tasks, supporting nested replies and user mentions.
model Comment {
  id                String   @id @default(uuid())
  task_id           String
  author_id         String
  body              String
  parent_comment_id String?
  mentions          String[] // Array of user IDs mentioned in body
  is_edited         Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  task           Task         @relation(fields: [task_id], references: [id], onDelete: Cascade)
  author         User         @relation("CommentAuthor", fields: [author_id], references: [id], onDelete: Restrict)
  parent_comment Comment?     @relation("ThreadedComments", fields: [parent_comment_id], references: [id], onDelete: Cascade)
  replies        Comment[]    @relation("ThreadedComments")
  attachments    Attachment[]

  @@index([task_id])
  @@index([author_id])
  @@index([parent_comment_id])
}

/// Files attached to tasks or comments.
model Attachment {
  id             String   @id @default(uuid())
  task_id        String
  comment_id     String?
  uploaded_by_id String
  file_url       String
  file_name      String
  mime_type      String
  size_bytes     BigInt
  created_at     DateTime @default(now())

  task        Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  comment     Comment? @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  uploaded_by User     @relation("UploadedAttachments", fields: [uploaded_by_id], references: [id], onDelete: Restrict)

  @@index([task_id])
  @@index([comment_id])
  @@index([uploaded_by_id])
}

/// User notifications for task events, status updates, and mentions.
model Notification {
  id           String           @id @default(uuid())
  recipient_id String
  actor_id     String?
  type         NotificationType
  entity_type  String           // e.g. "TASK", "COMMENT", "APPROVAL", "CONVERSATION"
  entity_id    String
  message      String
  is_read      Boolean          @default(false)
  read_at      DateTime?
  created_at   DateTime         @default(now())

  recipient User  @relation("RecipientNotifications", fields: [recipient_id], references: [id], onDelete: Cascade)
  actor     User? @relation("ActorNotifications", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([recipient_id, is_read])
  @@index([actor_id])
  @@index([entity_type, entity_id])
}

/// Immutable audit trail logging all state changes and system actions.
model ActivityLog {
  id            String   @id @default(uuid())
  task_id       String
  actor_id      String
  action        String   // e.g. "CREATED", "DELEGATED", "STATUS_CHANGED", "PROGRESS_UPDATED"
  field_changed String?
  old_value     String?
  new_value     String?
  ip_address    String?
  created_at    DateTime @default(now())

  task  Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  actor User @relation("ActorActivityLogs", fields: [actor_id], references: [id], onDelete: Restrict)

  @@index([task_id])
  @@index([actor_id])
  @@index([created_at])
}

/// Chat conversations (Direct, Group, or Task-linked thread).
model Conversation {
  id             String           @id @default(uuid())
  type           ConversationType @default(DIRECT)
  title          String?
  linked_task_id String?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  linked_task  Task?                     @relation(fields: [linked_task_id], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([linked_task_id])
}

/// Participant mapping for conversations with muted status and read receipts.
model ConversationParticipant {
  conversation_id String
  user_id         String
  last_read_at    DateTime?
  is_muted        Boolean   @default(false)
  joined_at       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([conversation_id, user_id])
  @@index([user_id])
}

/// Messages sent within a conversation, supporting attachments and replies.
model Message {
  id              String   @id @default(uuid())
  conversation_id String
  sender_id       String
  body            String
  attachment_url  String?
  reply_to_id     String?
  is_deleted      Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [sender_id], references: [id], onDelete: Restrict)
  reply_to     Message?     @relation("MessageReplies", fields: [reply_to_id], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReplies")

  @@index([conversation_id, created_at])
  @@index([sender_id])
}

/// Sign-off / approval requests for completed or submitted tasks.
model Approval {
  id              String         @id @default(uuid())
  task_id         String
  requested_by_id String
  approver_id     String
  status          ApprovalStatus @default(PENDING)
  remarks         String?
  decided_at      DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  task         Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  requested_by User @relation("RequestedApprovals", fields: [requested_by_id], references: [id], onDelete: Restrict)
  approver     User @relation("ApproverApprovals", fields: [approver_id], references: [id], onDelete: Restrict)

  @@index([task_id])
  @@index([approver_id, status])
  @@index([requested_by_id])
}

/// Task watchers (users who receive updates without being assigned to the task).
model TaskWatcher {
  task_id  String
  user_id  String
  added_at DateTime @default(now())

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user User @relation("UserWatchedTasks", fields: [user_id], references: [id], onDelete: Cascade)

  @@id([task_id, user_id])
  @@index([task_id])
  @@index([user_id])
}

/// Color-coded tags for labeling tasks.
model Tag {
  id         String    @id @default(uuid())
  name       String    @unique
  color      String    // Hex color code, e.g. "#4F46E5"
  created_at DateTime  @default(now())

  tasks TaskTag[]
}

/// Join table for Task <-> Tag many-to-many relationship.
model TaskTag {
  task_id String
  tag_id  String

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([task_id, tag_id])
  @@index([task_id])
  @@index([tag_id])
}
