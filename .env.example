# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Compliance Dashboard (KRA/KPI) integration — a dashboard account that can see all employees' KPIs.
# Scores are pulled read-only and shown on the "KRA & KPI" page, scoped by reporting hierarchy.
COMPLIANCE_API_URL="https://brick-four-compliance-dashboard.vercel.app"
COMPLIANCE_EMAIL=""
COMPLIANCE_PASSWORD=""

# GEMINI_MODEL: Optional. Model used by the admin-only AI assistant (default: gemini-2.5-flash).
GEMINI_MODEL="gemini-3.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB Atlas database
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"

# Resend (https://resend.com) — sends the "forgot password" reset link and the new-employee
# welcome email with their temporary password. Without these set, forgot-password falls back
# to returning the reset token directly in the API response (dev-only), and new-employee
# creation just shows the temp password on screen for the admin to share manually.
RESEND_API_KEY=""
# Must be a verified sender on the Resend account, e.g. "BrickFour <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=""

# Web Push (browser/phone notification bell ringing even when the tab is backgrounded or
# the browser is closed, e.g. for "Task Overdue" alerts). Generate a pair once with:
#   node -e "const w=require('web-push'); const k=w.generateVAPIDKeys(); console.log(k)"
# and set the SAME pair in every environment (local .env.local AND Vercel project settings) —
# changing them later invalidates every already-subscribed device, which must then re-subscribe.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Any contactable identifier — push services only use this to reach you if they see abuse.
VAPID_SUBJECT="mailto:admin@brickfour.com"

