# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Compliance Dashboard (KRA/KPI) integration — a dashboard account that can see all employees' KPIs.
# Scores are pulled read-only and shown on the "KRA & KPI" page, scoped by reporting hierarchy.
COMPLIANCE_API_URL="https://brick-four-compliance-dashboard.vercel.app"
COMPLIANCE_EMAIL=""
COMPLIANCE_PASSWORD=""

# GEMINI_MODEL: Optional. Model used by the admin-only AI assistant (default: gemini-2.5-flash).
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB Atlas database
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"

